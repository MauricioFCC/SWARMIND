# =============================================================================
# Swarmind — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control (.gitignore already excludes it).
#
#   cp .env.example .env
#
# =============================================================================

# ---------------------------------------------------------------------------
# API Keys (Cloud Model Providers)
# ---------------------------------------------------------------------------
# ZenFree API key (primary cloud provider for model routing)
ZENFREE_API_KEY=""

# Generic API key (fallback used in router.py when ZENFREE_API_KEY is empty)
# NOTE: Prefer ZENFREE_API_KEY or OPENAI_API_KEY over this generic fallback.
API_KEY=""

# OpenAI-compatible API key (used by _execute_openai_compat in router.py)
OPENAI_API_KEY=""

# OpenAI-compatible base URL (defaults to https://api.openai.com/v1)
OPENAI_BASE_URL="https://api.openai.com/v1"

# ---------------------------------------------------------------------------
# Slack Gateway (optional)
# ---------------------------------------------------------------------------
# Slack Bot Token (starts with xoxb-)
SLACK_BOT_TOKEN=""

# Default Slack channel
SLACK_CHANNEL="#dev"

# ---------------------------------------------------------------------------
# Telegram Gateway (optional)
# ---------------------------------------------------------------------------
# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=""

# Telegram Chat ID
TELEGRAM_CHAT_ID=""

# ---------------------------------------------------------------------------
# Hermes Sync — Memoria Centralizada entre Proyectos
# ---------------------------------------------------------------------------
# Ruta a la memoria compartida entre proyectos (cognition store).
# Si HERMES_ROOT no se configura, el sistema busca automaticamente:
#   1. Documents/shared_memory/  (repositorio dedicado)
#   2. Documents/Swarmind_MEMORY/          (fallback auto-creado)
# PORTABLE: funciona desde cualquier usuario/maquina sin modificar.
# HERMES_ROOT=""

# ---------------------------------------------------------------------------
# Model Router
# ---------------------------------------------------------------------------
# Force all routing to cloud (for testing)
# FORCE_CLOUD="true"

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL="INFO"
