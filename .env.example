# SWARMIND - configuracion de entorno portable (Windows / macOS / Linux)
#
# El harness lee estas variables via os.environ (12-Factor); los defaults del
# codigo son seguros, este archivo las hace explicitas y documenta el "como"
# por sistema. Los valores con "#" delante son opcionales (muestra el default).
#
# Forma portable de persistirlas (una vez por maquina):
#     python scripts/setup_local_env.py --llama-dir <tu-raiz-de-llama>
#
# ---------------------------------------------------------------------------
# Worker local SOLO TRIVIAL (politica 2026-10-10: cloud = oraculo/trabajo real)
# ---------------------------------------------------------------------------
SWARMIND_REQUIRE_LOCAL=0
#   - 0 (default): LOCAL SOLO TRIVIAL. El oraculo cloud resuelve el trabajo
#     real (calidad); el local (mimo) atiende SOLO tareas triviales via
#     small_model. Los LLM locales carecen de calidad frontier para
#     razonamiento/codigo complejo.
#   - 1: exigencia local SIEMPRE (si la flota gana calidad, se vuelve a 1).
#   - Windows:  setx SWARMIND_REQUIRE_LOCAL 0
#   - Linux/mac: export SWARMIND_REQUIRE_LOCAL=0   (en ~/.bashrc o ~/.zprofile)
#SWARMIND_LOCAL_FIRST_ENABLED=1     # politica local-first (default True)
#SWARMIND_LOCAL_FIRST_MAX_PARALLEL=2
#SWARMIND_LOCAL_FIRST_CLOUD_ORACLE=1

# ---------------------------------------------------------------------------
# Raiz de modelos / binarios llama.cpp (rutas portables en la SSOT)
# ---------------------------------------------------------------------------
#SWARMIND_LLAMA_DIR=C:\Users\TU\llama     # Windows (PowerShell: setx SWARMIND_LLAMA_DIR "C:\...\llama")
#SWARMIND_LLAMA_DIR=$HOME/llama           # Linux/macOS (bash/zsh: export en rc-file)
#
# Si NO usas llama-swap como launcher, el harness resuelve el binario asi:
#SWARMIND_LLAMA_EXECUTABLE=              # ruta al binario llama-server
#SWARMIND_LLAMA_CONFIG=                  # ruta al yaml de llama-swap
#SWARMIND_LLAMA_LAUNCHER=                # comando de arranque del backend
#SWARMIND_LOCAL_BASE_URL=http://127.0.0.1:11434

# ---------------------------------------------------------------------------
# Presupuestos GPU / contexto (anti-TDR en 8GB WDDM)
# ---------------------------------------------------------------------------
#SWARMIND_GPU_BUDGET_MB=8000
#SWARMIND_SAFE_CTX_MAX=36864             # medido seguro; 40960 causo TDR
#SWARMIND_MIN_FREE_VRAM_MB=1500          # margen de seguridad
#SWARMIND_VRAM_SAFETY_MARGIN_MB=1500

# ---------------------------------------------------------------------------
# Governor / circuit breaker (Failure-Spend Governance)
# ---------------------------------------------------------------------------
#SWARMIND_CB_MAX_FAILURES=3              # fallos antes de abrir el breaker
#SWARMIND_CB_COOLDOWN_S=60               # enfriamiento tras abrir
#SWARMIND_GOVERNOR_ACQUIRE_TIMEOUT_S=30

# Vector backend (ruscadb default, lancedb legacy)
VECTOR_BACKEND=ruscadb
RUSCADB_PATH=
MEMORY_BACKEND=ruscadb
