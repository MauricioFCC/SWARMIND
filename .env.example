# =============================================================================
# AGENTIC — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control (.gitignore already excludes it).
#
#   cp .env.example .env
#
# =============================================================================

# ---------------------------------------------------------------------------
# API Keys (Cloud Model Providers)
# ---------------------------------------------------------------------------
# ZenFree API key (primary cloud provider for model routing)
ZENFREE_API_KEY=""

# Generic API key (fallback used in router.py when ZENFREE_API_KEY is empty)
# NOTE: Prefer ZENFREE_API_KEY or OPENAI_API_KEY over this generic fallback.
API_KEY=""

# OpenAI-compatible API key (used by _execute_openai_compat in router.py)
OPENAI_API_KEY=""

# OpenAI-compatible base URL (defaults to https://api.openai.com/v1)
OPENAI_BASE_URL="https://api.openai.com/v1"

# ---------------------------------------------------------------------------
# Slack Gateway (optional)
# ---------------------------------------------------------------------------
# Slack Bot Token (starts with xoxb-)
SLACK_BOT_TOKEN=""

# Default Slack channel
SLACK_CHANNEL="#dev"

# ---------------------------------------------------------------------------
# Telegram Gateway (optional)
# ---------------------------------------------------------------------------
# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=""

# Telegram Chat ID
TELEGRAM_CHAT_ID=""

# ---------------------------------------------------------------------------
# Hermes Sync — Memoria General entre Proyectos
# ---------------------------------------------------------------------------
# Ruta al repositorio Hermes_Memory_Proyects (memoria compartida entre proyectos).
# Todas las cognition stores de todos los proyectos se sincronizan aqui.
# Si no se configura, el HermesBridge opera en modo degradado (solo warnings).
HERMES_ROOT="C:\Users\USUARIO\Documents\Hermes_Memory_Proyects"

# ---------------------------------------------------------------------------
# Model Router
# ---------------------------------------------------------------------------
# Force all routing to cloud (for testing)
# FORCE_CLOUD="true"

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL="INFO"
