{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    ".opencode/core/base_principles.md"
  ],
  "model": "ollama/hf.co/empero-ai/Qwen3.8-9B-Distill-GGUF:Q4_K_M",
  "agent": {
    "coordinator": {
      "mode": "primary",
      "permission": {
        "task": {
          "*": "ask",
          "builder-*": "allow",
          "scientist-*": "allow",
          "guardian-*": "allow"
        }
      }
    },
    "builder": {
      "mode": "subagent",
      "permission": {
        "edit": "allow",
        "bash": "ask"
      }
    },
    "guardian": {
      "mode": "subagent",
      "permission": {
        "edit": "deny",
        "bash": "allow"
      }
    },
    "scientist": {
      "mode": "subagent",
      "permission": {
        "edit": "deny",
        "bash": "ask",
        "webfetch": "allow"
      }
    }
  },
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "hf.co/empero-ai/Qwen3.8-9B-Distill-GGUF:Q4_K_M": {
          "name": "Qwen3.8 9B Q4 quality",
          "reasoning": true,
          "tools": true,
          "options": {
            "num_ctx": 8192
          }
        },
        "hf.co/Jackrong/Qwopus3.5-9B-Coder-GGUF:Qwopus3.5-9B-coder-Exp-Q4_K_M": {
          "name": "Qwopus3.5 9B Q4 coding",
          "reasoning": false,
          "tools": true,
          "options": {
            "num_ctx": 8192
          }
        },
        "hf.co/openbmb/MiniCPM5-2B-GGUF:Q8_0": {
          "name": "MiniCPM5 2B Q8 trivial",
          "reasoning": false,
          "tools": true,
          "options": {
            "num_ctx": 8192
          }
        },
        "hf.co/unsloth/GLM-Z1-9B-0414-GGUF:UD-Q4_K_XL": {
          "name": "GLM-Z1 9B Q4 reasoning",
          "reasoning": true,
          "tools": true,
          "options": {
            "num_ctx": 8192
          }
        }
      }
    }
  },
  "skills": {
    "paths": [
      ".opencode/skills"
    ]
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 2000
  },
  "tool_output": {
    "max_lines": 200,
    "max_bytes": 8192
  },
  "experimental": {
    "mcp_timeout": 30000
  }
}