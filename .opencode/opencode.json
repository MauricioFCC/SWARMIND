{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    ".opencode/core/base_principles.min.md"
  ],
  "model": "llamacpp/qwen2.5-coder-3b-iq4-xs",
  "small_model": "llamacpp/qwen2.5-coder-3b-iq4-xs",
  "agent": {
    "coordinator": {
      "mode": "primary",
      "model": "opencode-go/deepseek-v4.1-flash",
      "permission": {
        "task": {
          "*": "ask",
          "builder-*": "allow",
          "scientist-*": "allow",
          "guardian-*": "allow"
        }
      }
    },
    "builder": {
      "mode": "subagent",
      "model": "llamacpp/qwen2.5-coder-3b-iq4-xs",
      "permission": {
        "edit": "allow",
        "bash": "ask"
      }
    },
    "guardian": {
      "mode": "subagent",
      "model": "llamacpp/phi-4-mini-instruct-q4-k-m",
      "permission": {
        "edit": "deny",
        "bash": "allow"
      }
    },
    "scientist": {
      "mode": "subagent",
      "model": "llamacpp/phi-4-mini-instruct-q4-k-m",
      "permission": {
        "edit": "deny",
        "bash": "ask",
        "webfetch": "allow"
      }
    },
    "reviewer": {
      "model": "llamacpp/deepseek-r1-distill-qwen-7b-q2-k"
    }
  },
  "provider": {
    "llamacpp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama.cpp (llama-swap local :11434)",
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1"
      },
      "models": {
        "qwen2.5-coder-3b-iq4-xs": {
          "name": "qwen2.5-coder-3b-iq4-xs (coding)",
          "reasoning": false,
          "tools": true,
          "options": {
            "num_ctx": 32768
          }
        },
        "phi-4-mini-instruct-q4-k-m": {
          "name": "phi-4-mini-instruct-q4-k-m (reasoning/general)",
          "reasoning": true,
          "tools": true,
          "options": {
            "num_ctx": 32768
          }
        },
        "qwen3-5-4b-gguf-ud-q4-k-xl": {
          "name": "qwen3-5-4b-gguf-ud-q4-k-xl (fast)",
          "reasoning": true,
          "tools": true,
          "options": {
            "num_ctx": 32768
          }
        },
        "deepseek-r1-distill-qwen-7b-q2-k": {
          "name": "deepseek-r1-distill-qwen-7b-q2-k (deep)",
          "reasoning": true,
          "tools": true,
          "options": {
            "num_ctx": 32768
          }
        },
        "qwen3-embedding-0-6b": {
          "name": "qwen3-embedding-0-6b (embeddings/RAG)",
          "reasoning": false,
          "tools": false,
          "options": {
            "num_ctx": 8192
          }
        }
      }
    }
  },
  "skills": {
    "paths": [
      ".opencode/skills"
    ]
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 2000
  },
  "tool_output": {
    "max_lines": 200,
    "max_bytes": 8192
  },
  "experimental": {
    "mcp_timeout": 30000
  }
}
