{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [".opencode/core/base_principles.md"],
  "model": "ollama/onyx-edge",
  "agent": {
    "coordinator": {
      "mode": "primary",
      "permission": {
        "task": {
          "*": "ask",
          "builder-*": "allow",
          "scientist-*": "allow",
          "guardian-*": "allow"
        }
      }
    },
    "builder": {
      "mode": "subagent",
      "permission": {
        "edit": "allow",
        "bash": "ask"
      }
    },
    "guardian": {
      "mode": "subagent",
      "permission": {
        "edit": "deny",
        "bash": "allow"
      }
    },
    "scientist": {
      "mode": "subagent",
      "permission": {
        "edit": "deny",
        "bash": "ask",
        "webfetch": "allow"
      }
    }
  },
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen3:4b": {
          "name": "qwen3:4b (local fast)",
          "reasoning": false,
          "tools": true
        },
        "deepseek-r1:8b": {
          "name": "deepseek-r1:8b (local quality)",
          "reasoning": true,
          "tools": true
        },
        "qwen2.5-coder:7b": {
          "name": "qwen2.5-coder:7b (local coding)",
          "reasoning": false,
          "tools": true
        },
        "qwen2.5-coder:7b-instruct": {
          "name": "qwen2.5-coder:7b-instruct (local coding instruct)",
          "reasoning": false,
          "tools": true
        },
        "llama3.2:3b": {
          "name": "llama3.2:3b (local ultra-fast trivial)",
          "reasoning": false,
          "tools": true
        },
        "qwen3-vl:4b": {
          "name": "qwen3-vl:4b (local vision)",
          "reasoning": false,
          "tools": true
        },
        "onyx-edge": {
          "name": "onyx-edge (local fast, LFM2.5)",
          "reasoning": false,
          "tools": true
        },
        "onyx-cerebro": {
          "name": "onyx-cerebro (local quality, Qwen3.8)",
          "reasoning": true,
          "tools": true
        },
        "onyx-coder": {
          "name": "onyx-coder (local coding, Qwopus3.5)",
          "reasoning": false,
          "tools": true
        },
        "onyx-flash": {
          "name": "onyx-flash (local potente, DeepSeek-Flash 9B)",
          "reasoning": true,
          "tools": true
        },
        "onyx-secretario": {
          "name": "onyx-secretario (local trivial, MiniCPM5)",
          "reasoning": false,
          "tools": true
        },
        "onyx-moe": {
          "name": "onyx-moe (local eficiente, OLMoE)",
          "reasoning": false,
          "tools": true
        },
        "onyx-reasoning": {
          "name": "onyx-reasoning (local deep, GLM-Z1)",
          "reasoning": true,
          "tools": true
        }
      }
    }
  },
  "skills": {
    "paths": [".opencode/skills"]
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 10000
  },
  "tool_output": {
    "max_lines": 200,
    "max_bytes": 8192
  },
  "experimental": {
    "mcp_timeout": 30000
  }
}
