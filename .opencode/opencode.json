{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [".opencode/core/base_principles.md"],
  "model": "ollama/qwen3:4b",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen3:4b": {
          "name": "qwen3:4b (local fast)",
          "reasoning": false,
          "tools": true
        },
        "deepseek-r1:8b": {
          "name": "deepseek-r1:8b (local quality)",
          "reasoning": true,
          "tools": true
        },
        "qwen2.5-coder:7b": {
          "name": "qwen2.5-coder:7b (local coding)",
          "reasoning": false,
          "tools": true
        },
        "qwen2.5-coder:7b-instruct": {
          "name": "qwen2.5-coder:7b-instruct (local coding instruct)",
          "reasoning": false,
          "tools": true
        },
        "llama3.2:3b": {
          "name": "llama3.2:3b (local ultra-fast trivial)",
          "reasoning": false,
          "tools": true
        },
        "qwen3-vl:4b": {
          "name": "qwen3-vl:4b (local vision)",
          "reasoning": false,
          "tools": true
        }
      }
    }
  },
  "skills": {
    "paths": [".opencode/skills"]
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 10000
  },
  "tool_output": {
    "max_lines": 200,
    "max_bytes": 8192
  },
  "experimental": {
    "mcp_timeout": 30000
  }
}
