{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    ".opencode/core/base_principles.min.md"
  ],
  "model": "opencode-go/deepseek-v4.1-flash",
  "small_model": "llamacpp/phi-4-mini-instruct-q4-k-m",
  "permission": {
    "bash": "allow",
    "edit": "allow",
    "webfetch": "ask",
    "task": "allow"
  },
  "agent": {
    "coordinator": {
      "mode": "primary",
      "model": "opencode-go/deepseek-v4.1-flash"
    },
    "builder": {
      "mode": "subagent",
      "model": "llamacpp/qwen2.5-coder-3b-iq4-xs"
    },
    "guardian": {
      "mode": "subagent",
      "model": "llamacpp/phi-4-mini-instruct-q4-k-m"
    },
    "scientist": {
      "mode": "subagent",
      "model": "llamacpp/phi-4-mini-instruct-q4-k-m"
    },
    "reviewer": {
      "model": "llamacpp/phi-4-mini-instruct-q4-k-m"
    },
    "architect": {
      "model": "llamacpp/phi-4-mini-instruct-q4-k-m"
    },
    "backend-engineer": {
      "model": "llamacpp/qwen2.5-coder-3b-iq4-xs"
    },
    "data-engineer": {
      "model": "llamacpp/phi-4-mini-instruct-q4-k-m"
    },
    "database-administrator": {
      "model": "llamacpp/qwen2.5-coder-3b-iq4-xs"
    },
    "devops": {
      "model": "llamacpp/qwen2.5-coder-3b-iq4-xs"
    },
    "frontend-engineer": {
      "model": "llamacpp/qwen2.5-coder-3b-iq4-xs"
    },
    "mobile-engineer": {
      "model": "llamacpp/qwen2.5-coder-3b-iq4-xs"
    },
    "platform-engineer": {
      "model": "llamacpp/qwen2.5-coder-3b-iq4-xs"
    },
    "product-manager": {
      "model": "llamacpp/phi-4-mini-instruct-q4-k-m"
    },
    "qa-engineer": {
      "model": "llamacpp/phi-4-mini-instruct-q4-k-m"
    },
    "release-ops": {
      "model": "llamacpp/qwen2.5-coder-3b-iq4-xs"
    },
    "researcher": {
      "model": "llamacpp/phi-4-mini-instruct-q4-k-m"
    },
    "security-engineer": {
      "model": "llamacpp/qwen2.5-coder-3b-iq4-xs"
    },
    "test-writer": {
      "model": "llamacpp/qwen2.5-coder-3b-iq4-xs"
    },
    "explore": {
      "model": "llamacpp/phi-4-mini-instruct-q4-k-m"
    },
    "general": {
      "model": "llamacpp/phi-4-mini-instruct-q4-k-m"
    },
    "evolve": {
      "model": "llamacpp/phi-4-mini-instruct-q4-k-m"
    },
    "evolve-analyzer": {
      "model": "llamacpp/phi-4-mini-instruct-q4-k-m"
    },
    "evolve-engineer": {
      "model": "llamacpp/qwen2.5-coder-3b-iq4-xs"
    },
    "evolve-researcher": {
      "model": "llamacpp/phi-4-mini-instruct-q4-k-m"
    },
    "token-budget-auditor": {
      "model": "llamacpp/phi-4-mini-instruct-q4-k-m"
    }
  },
  "provider": {
    "llamacpp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama.cpp (llama-swap local :11434)",
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1"
      },
      "models": {
        "qwen2.5-coder-3b-iq4-xs": {
          "name": "qwen2.5-coder-3b-iq4-xs (coding)",
          "reasoning": false,
          "tools": true,
          "options": {
            "num_ctx": 36864
          }
        },
        "phi-4-mini-instruct-q4-k-m": {
          "name": "phi-4-mini-instruct-q4-k-m (data/signals)",
          "reasoning": true,
          "tools": true,
          "options": {
            "num_ctx": 36864
          }
        },
        "qwen3-embedding-0-6b": {
          "name": "qwen3-embedding-0-6b (embeddings/RAG)",
          "reasoning": false,
          "tools": false,
          "options": {
            "num_ctx": 8192
          }
        }
      }
    }
  },
  "skills": {
    "paths": [
      ".opencode/skills"
    ]
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 2000
  },
  "tool_output": {
    "max_lines": 200,
    "max_bytes": 8192
  },
  "experimental": {
    "mcp_timeout": 30000
  }
}
