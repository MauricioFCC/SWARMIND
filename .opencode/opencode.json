{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    ".opencode/core/base_principles.md"
  ],
  "model": "ollama/qwen38-9b-16k",
  "agent": {
    "coordinator": {
      "mode": "primary",
      "permission": {
        "task": {
          "*": "ask",
          "builder-*": "allow",
          "scientist-*": "allow",
          "guardian-*": "allow"
        }
      }
    },
    "builder": {
      "mode": "subagent",
      "permission": {
        "edit": "allow",
        "bash": "ask"
      }
    },
    "guardian": {
      "mode": "subagent",
      "permission": {
        "edit": "deny",
        "bash": "allow"
      }
    },
    "scientist": {
      "mode": "subagent",
      "permission": {
        "edit": "deny",
        "bash": "ask",
        "webfetch": "allow"
      }
    }
  },
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen38-9b-16k": {
          "name": "Qwen3.8 9B Q4 quality (ctx 16K baked)",
          "reasoning": true,
          "tools": true
        },
        "qwopus-v3-9b-16k": {
          "name": "Qwopus3.5-9B v3 Q4 coding (frontera 2026)",
          "reasoning": false,
          "tools": true
        },
        "minicpm5-2b-32k": {
          "name": "MiniCPM5 2B Q8 fast (ctx 32K baked)",
          "reasoning": false,
          "tools": true
        },
        "opus-distill-9b-16k": {
          "name": "Qwen3.5-9B Claude-Opus-Distill v2 (razonamiento)",
          "reasoning": true,
          "tools": true
        }
      }
    }
  },
  "skills": {
    "paths": [
      ".opencode/skills"
    ]
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 2000
  },
  "tool_output": {
    "max_lines": 200,
    "max_bytes": 8192
  },
  "experimental": {
    "mcp_timeout": 30000
  }
}