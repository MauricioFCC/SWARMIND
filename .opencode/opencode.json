{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [".opencode/core/base_principles.md"],
  "skills": {
    "paths": [".opencode/skills"]
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 10000
  },
  "tool_output": {
    "max_lines": 200,
    "max_bytes": 8192
  },
  "experimental": {
    "mcp_timeout": 30000
  }
}
