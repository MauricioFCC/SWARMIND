#!/bin/sh
# pre-push: bloquea el push si se intentan publicar ADR (docs/src/es/adr/).
# Los ADR se versionan localmente (importantes para el historial) pero NO se
# pushean al remoto (son internos del proyecto).
#
# Instalacion: git config core.hooksPath .githooks  (o copiar a .git/hooks/pre-push)
#
# Uso: es invocado automaticamente por `git push`. Si los commits del push
# tocan docs/src/es/adr/, el push se ABORTA con un mensaje claro.

set -u

ADR_PATH="docs/src/es/adr/"

# stdin de git push: <local_ref> <local_sha> <remote_ref> <remote_sha>
while read -r local_ref local_sha remote_ref remote_sha; do
    if [ "$local_sha" = "0000000000000000000000000000000000000000" ]; then
        # Eliminacion de rama remota: no hay nada que validar
        continue
    fi

    if [ -z "$remote_sha" ] || [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
        # Rama nueva en remoto: validar todo el rango local
        range="$local_sha"
    else
        range="${remote_sha}..${local_sha}"
    fi

    if git diff --name-only "$range" 2>/dev/null | grep -q "^${ADR_PATH}"; then
        echo "ERROR: push bloqueado por .githooks/pre-push"
        echo "Los ADR (${ADR_PATH}) se versionan localmente pero NO se publican al remoto."
        echo "Los commits de este push contienen cambios en esa ruta. Excluye los ADR antes de pushear."
        echo "Si realmente quieres publicarlos, desinstala el hook: git config core.hooksPath ''"
        exit 1
    fi
done

exit 0
